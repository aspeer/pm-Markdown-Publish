# Version control files and dirs.
\bRCS\b
\bCVS\b
,v$
.svn/
^\.git/

# ExtUtils::MakeMaker generated files and dirs.
^MANIFEST\.(?!SKIP)
^Makefile$
^Makefile\.\d+$
^blib/
^blibdirs$
^pm_to_blib$
^PM_to_blib$
^MakeMaker-\d
^MYMETA\.

# Module::Build
^Build$
^_build

# Temp, old, vi and emacs files.
^\.DS_Store$
(^|/)\._.*$
\.DS_Store$
~$
\.~.*$
\.old$
^#.*#$
^\.#
\.swp$
\.bak$
^\.vscode/

# Git
^\.gitignore

# Local generated development files.
^a$
^foo/
^site/
^\.markdown-pod\.json$
